# Kimi AI API Key from https://platform.moonshot.cn/
VITE_KIMI_API_KEY=your_kimi_api_key_here

# Hugging Face token
VITE_HF_TOKEN=your_hf_token_here

# Kaggle MCP token (starts with KGAT_...)
KAGGLE_API_TOKEN=KGAT_your_token_here

# Optional override (defaults to https://www.kaggle.com/mcp)
KAGGLE_MCP_URL=https://www.kaggle.com/mcp
